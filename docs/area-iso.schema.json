{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/plenarius/nwn-bake/main/docs/area-iso.schema.json",
  "title": "nwn-bake area picture manifest, version 1",
  "description": "The manifest `nwn-bake area-iso` writes beside an area's pictures (<area>.json, or json/<area>.json in a batch's folder). See area-iso.md. Fields not listed here may be added without a new version; readers ignore fields they do not know.",
  "type": "object",
  "required": [
    "format",
    "version",
    "renderer",
    "area",
    "inputs",
    "resources",
    "key",
    "options",
    "roof_cut_m",
    "views",
    "notes"
  ],
  "properties": {
    "format": {
      "const": "nwn-bake/area-iso"
    },
    "version": {
      "const": 1
    },
    "renderer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "pictures": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "area": {
      "type": "object",
      "required": [
        "resref",
        "name",
        "tileset",
        "tiles",
        "size_m",
        "kind"
      ],
      "properties": {
        "resref": {
          "$ref": "#/$defs/resref"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tileset": {
          "$ref": "#/$defs/resref"
        },
        "tiles": {
          "$ref": "#/$defs/size"
        },
        "size_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "kind": {
          "enum": [
            "surface",
            "interior",
            "underground"
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "are",
        "git",
        "haks",
        "missing_haks",
        "tlk"
      ],
      "properties": {
        "are": {
          "$ref": "#/$defs/sha256"
        },
        "git": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "haks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_haks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tlk": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resources": {
      "description": "The digest of every resource the scene looked up (name, how, and the SHA-256 of what was found). Null when the pictures were drawn without keys.",
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "description": "The exact key: what the pictures are made of, resources included (area-iso.md, Keys).",
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "scale",
        "quality",
        "light",
        "shadows",
        "roof",
        "exposure",
        "objects",
        "background",
        "look"
      ],
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "light": {
          "enum": [
            "day",
            "area"
          ]
        },
        "shadows": {
          "type": "boolean"
        },
        "roof": {
          "description": "\"auto\", \"keep\", or the metres over the floor given.",
          "oneOf": [
            {
              "enum": [
                "auto",
                "keep"
              ]
            },
            {
              "type": "number"
            }
          ]
        },
        "exposure": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "objects": {
          "type": "boolean"
        },
        "background": {
          "oneOf": [
            {
              "const": "transparent"
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          ]
        },
        "look": {
          "description": "\"default\", or every calibration constant when any differs from the default.",
          "oneOf": [
            {
              "const": "default"
            },
            {
              "type": "object"
            }
          ]
        },
        "format": {
          "enum": [
            "webp",
            "png"
          ]
        },
        "webp_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "depth": {
          "type": "boolean"
        }
      }
    },
    "roof_cut_m": {
      "description": "The height (metres) above which everything was cut away; null when the roof was kept.",
      "type": [
        "number",
        "null"
      ]
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quick_key": {
      "description": "The quick key: the same, with every hak's digest in place of the resources. Null when it was not worked out (a run of named areas with no cache).",
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "resref": {
      "type": "string",
      "pattern": "^[a-z0-9_]{0,16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "row": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "view": {
      "type": "object",
      "required": [
        "view",
        "file",
        "depth",
        "width",
        "height",
        "scale",
        "elevation_deg",
        "rotation",
        "offset",
        "matrix"
      ],
      "properties": {
        "view": {
          "enum": [
            "sw",
            "se",
            "ne",
            "nw",
            "top"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "description": "The depth picture's file (16-bit grey PNG): 0 where nothing is drawn, else z = depth_range[0] + value / 65535 * (depth_range[1] - depth_range[0]). Null without --depth.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elevation_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "rotation": {
          "description": "The view's quarter turn: x' = r[0][0] x + r[0][1] y, y' = r[1][0] x + r[1][1] y.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "enum": [
                -1,
                0,
                1
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 2
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "matrix": {
          "description": "The normative transform: (px, py) = matrix (x, y, z, 1), pixels from the picture's top-left corner, game metres.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "depth_range": {
          "description": "The heights (metres) the depth picture's 0 and 65535 stand for; present with depth.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bytes": {
          "description": "The picture file's size.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "dependentRequired": {
        "depth_range": [
          "depth"
        ]
      }
    }
  }
}
